    classDef def    fill:#EAF2FF,stroke:#1A73E8,stroke-width:2px,color:#0B1F3B;
    classDef reg    fill:#E6F4EA,stroke:#137333,stroke-width:2px,color:#0A2E17;
    classDef rec    fill:#FFF4E5,stroke:#F29900,stroke-width:2px,color:#3B2A00;
    classDef rate   fill:#F3E8FF,stroke:#8430CE,stroke-width:2px,color:#2A0B3B;

    class DESC,TECH,DEPLOY def;
    class A1,A2,A3,A4,NOTE,PA reg;
